# --- Base de données -------------------------------------------------------
# Chaîne de connexion MongoDB Atlas. Le cluster doit être un jeu de réplicas
# (c'est le cas par défaut sur Atlas) : Better Auth y ouvre des transactions.
MONGODB_URI="mongodb+srv://utilisateur:motdepasse@cluster.exemple.mongodb.net/?retryWrites=true&w=majority"
# Nom de la base à l'intérieur du cluster.
MONGODB_DB="gw2rp"

# --- Authentification ------------------------------------------------------
# Secret de signature des sessions. À générer une fois :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# --- Site ------------------------------------------------------------------
# L'URL canonique, sans barre oblique finale. En production : https://www.gw2rp.eu
# Sur Vercel, si elle n'est pas posée, l'URL du déploiement est utilisée.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Téléversement d'images ------------------------------------------------
# Jeton du magasin Vercel Blob. Sur Vercel il est posé automatiquement quand un
# magasin Blob est rattaché au projet ; en local, copiez-le depuis le tableau de
# bord (Storage → votre magasin → .env.local).
BLOB_READ_WRITE_TOKEN=""

# --- Carte (facultatif) ----------------------------------------------------
# Service de tuiles. Par défaut, le service officiel du jeu.
# NEXT_PUBLIC_MAP_TILE_URL="https://tiles.guildwars2.com/1/1/{z}/{x}/{y}.jpg"
